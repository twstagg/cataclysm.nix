# Bundle the mod-registry content release builds ship (see
# build-scripts/bundle-registry-mods.ts) as a pure derivation.
#
# The script joins two sources: the lockfile data/mods/external.json
# (id/version/url/extract_path) and the registry metadata at
# https://mods.cataclysmbn.org/generated/mods.json (display name,
# package_type, homepage, license). This derivation mirrors that join:
# ids/versions/urls come from the lockfile in `src`, registry fields
# from the vendored cbn/registry-mods.json snapshot, and each archive
# from a pinned fetchurl. The build then replicates the script's
# extract/verify semantics (lock extract_path wins, single-root
# fallback, marker-file verification, credits file).
#
# Why the registry is vendored rather than fetched: mods.json is
# regenerated often, so a hash pin on it breaks the whole flake at eval
# time. Vendoring turns that into a reviewable diff, and removes the
# eval-time import-from-derivation that pinning it required.
#
# Why urls resolve to registry commits: every lockfile url is a branch
# archive, so any upstream push breaks the pin. The registry tracks each
# mod by commit or tag, and those urls are immutable, so we use them when
# available (see resolveUrl).
#
# Notes for maintainers:
#   * Refreshing: run `nix run .#cbn-update-registry-mods` (or `--check` to
#     preview). It regenerates cbn/registry-mods.json from the live
#     registry, resolves urls through it, and re-prefetches the pins
#     below.
#   * Only otopack_bn_mk_2 is a soundpack; everything else lands in
#     mods/. If the registry ever marks another entry as a soundpack,
#     the routing below picks it up with no other changes.
{
  lib,
  stdenv,
  fetchurl,
  unzip,
  # Repo checkout, so data/mods/external.json (the lockfile) always
  # tracks the working tree instead of being pinned separately.
  src,
}:

let
  inherit (lib) escapeShellArg;

  lockEntries = builtins.fromJSON (builtins.readFile (src + "/data/mods/external.json"));

  # Registry metadata for the locked ids, keyed by id. Generated by
  # ./scripts/update-registry-mods.sh from the live registry; do not hand-edit.
  registryJson = builtins.fromJSON (builtins.readFile ./registry-mods.json);

  # GitHub archive urls share a prefix up to /archive/, so a recorded
  # commit can be substituted into any of them.
  archiveBase =
    url:
    let
      parts = lib.splitString "/archive/" url;
    in
    if lib.length parts == 2 then lib.head parts else null;

  # Prefer an already-immutable url, in order: the lockfile's own (a
  # release tag pins archives by commit, which is exactly what that
  # release shipped), then the registry's recorded commit, then the
  # registry's tag url. Only a branch url with nothing better recorded
  # falls through to the moving url, so every pin is immutable.
  #
  # The lockfiles differ between tracks here: v0.13.0 pins by commit,
  # master tracks branches. Resolving the same way makes both tracks
  # fetch the same bytes, which is why one bundle serves both.
  resolveUrl =
    lock: reg:
    let
      lockUrl = lock.url;
      url = reg.source.url;
      base = archiveBase url;
      sha = reg.source.commit_sha or null;
    in
    if !lib.hasInfix "/refs/heads/" lockUrl then
      lockUrl
    else if base != null && sha != null then
      "${base}/archive/${sha}.zip"
    else if !lib.hasInfix "/refs/heads/" url then
      url
    else
      lockUrl;

  # Archive hashes, one per lockfile id (shared urls repeat the hash;
  # identical fixed-output fetches dedupe to one store path). Rewritten
  # by ./scripts/update-registry-mods.sh; keep one entry per line, sorted.
  hashes = {
    "cata" = "sha256-OXXikqmVaLznmIBIe5ps21M0lU1tQdPaUgCHZYTACM4=";
    "cbn_sky_island" = "sha256-jzt2qJe5FmJ1sxO6xPKA7cLjVHrQI39Cpb4lx94hKpo=";
    "jake_s_squirrel_mod" = "sha256-wsQt857uF4eHXbrXFJWU1TAOnF0QLBh+3eDj+loOKy8=";
    "medieval_mod_reborn" = "sha256-WIYVfD9m+xBpF83MzWslQPaWriOmMmxGnzRKs5ZLoaY=";
    "mst_extra" = "sha256-wCOYUOefqhhK6eHstX22oWgBmzHzusEpU3mFDYhT9Kk=";
    "ny_transformers" = "sha256-+r8rQTR6KUUvXsqxtP4I7IVSZIFeW/CHALTnebs+xm0=";
    "otopack_bn_mk_2" = "sha256-2RqpyW9LVz1Q+2v3qi/pM+Mq0yZMIen/Ki4+BMfpCbo=";
    "overhaul" = "sha256-br34Lgeyx5BKbwbYYlSTuDbow8iq+890lQdGClw+Tp8=";
    "overhaul_additions" = "sha256-br34Lgeyx5BKbwbYYlSTuDbow8iq+890lQdGClw+Tp8=";
  };

  # Join one lockfile entry with its registry metadata, mirroring
  # selectEntries/targetDir: the lock version wins, the lock extract_path
  # wins over the registry one, and the target dir is the last
  # extract_path component (or the id when there is no path). The archive
  # url is the exception: it resolves through the registry so the pin
  # targets immutable content.
  entries = map (
    lock:
    let
      registry =
        registryJson.${lock.id}
          or (throw "./registry-mods.nix: '${lock.id}' is not present in the mod registry snapshot (cbn/registry-mods.json); run nix run .#cbn-update-registry-mods");
      # The lockfile uses 0.0.0 as a placeholder for branch-tracking
      # mods the registry auto-versions, so those mismatches are
      # permanent by convention. Warn only when a real pinned version
      # disagrees with the registry: that is lockfile drift worth
      # seeing, and the eval-time warning would otherwise be all noise.
      checked =
        if registry.version != lock.version && lock.version != "0.0.0" then
          lib.warn "${lock.id} version mismatch: lockfile has ${lock.version}, registry has ${registry.version}; using locked version" registry
        else
          registry;
      extractPath = lock.extract_path or checked.source.extract_path or null;
      packageType = checked.package_type or "mod";
    in
    {
      inherit (lock) id;
      url = resolveUrl lock registry;
      archive = fetchurl {
        url = resolveUrl lock registry;
        hash =
          hashes.${lock.id}
            or (throw "./registry-mods.nix: no pinned hash for locked mod '${lock.id}'; run nix run .#cbn-update-registry-mods");
      };
      inherit extractPath packageType;
      target = if extractPath == null then lock.id else lib.last (lib.splitString "/" extractPath);
      destSubdir = if packageType == "soundpack" then "sound" else "mods";
      display_name = checked.display_name;
      homepage = checked.homepage or "unknown";
      license = checked.license or "unknown";
    }
  ) lockEntries;

  bundleCall = entry: ''
    bundle_entry \
      ${escapeShellArg entry.id} \
      ${entry.archive} \
      ${escapeShellArg (entry.extractPath or "")} \
      ${escapeShellArg entry.target} \
      ${escapeShellArg entry.destSubdir} \
      ${escapeShellArg entry.display_name} \
      ${escapeShellArg entry.homepage} \
      ${escapeShellArg entry.license} \
      ${escapeShellArg entry.url}
  '';
in
stdenv.mkDerivation {
  pname = "cbn-registry-mods";
  version = "external-json";

  dontUnpack = true;
  nativeBuildInputs = [ unzip ];
  strictDeps = true;

  buildPhase = ''
        runHook preBuild

        bundle_entry() {
          local id="$1" archive="$2" extract="$3" target="$4" subdir="$5"
          local display="$6" homepage="$7" license="$8" url="$9"
          echo "$id bundled as $subdir/$target"

          local tmp
          tmp=$(mktemp -d)
          unzip -q "$archive" -d "$tmp"

          # Mirror findExtractDir: trailing-component match on the extract
          # path, single-root fallback when the entry has no path.
          local src_dir=""
          if [ -n "$extract" ]; then
            # Mirror findExtractDir: match the trailing path components only.
            # A commit-pinned archive names its root after the sha while the
            # recorded extract path still names the branch, so the recorded
            # path is retried without its root component.
            find_match() {
              local want="$1" depth candidate
              depth=$(printf '%s' "$want" | awk -F/ '{print NF}')
              while read -r candidate; do
                if [ "$(printf '%s' "$candidate" | tr '/' '\n' | tail -n "$depth" | paste -sd/ -)" = "$want" ]; then
                  printf '%s\n' "$candidate"
                  return 0
                fi
              done <<< "$(find "$tmp" -type d)"
              return 1
            }
            src_dir="$(find_match "$extract")" \
              || src_dir="$(find_match "$(printf '%s' "$extract" | cut -d/ -f2-)" || true)"
            if [ -z "$src_dir" ]; then
              echo "$id: archive did not contain $extract" >&2
              exit 1
            fi
          else
            local roots
            roots=$(find "$tmp" -mindepth 1 -maxdepth 1 -type d)
            if [ "$(printf '%s\n' "$roots" | wc -l)" -ne 1 ]; then
              echo "$id: archive has multiple roots" >&2
              exit 1
            fi
            src_dir=$roots
          fi

          local dest="bundle-root/$subdir/$target"
          mkdir -p "$(dirname "$dest")"
          rm -rf "$dest"
          cp -r "$src_dir" "$dest"
          rm -rf "$tmp"

          # Mirror verify: mods carry modinfo.json, soundpacks carry
          # soundpack.txt or soundpack.json.
          if [ "$subdir" = "sound" ]; then
            if [ ! -f "$dest/soundpack.txt" ] && [ ! -f "$dest/soundpack.json" ]; then
              echo "$id: did not extract soundpack.txt or soundpack.json" >&2
              exit 1
            fi
          else
            if [ ! -f "$dest/modinfo.json" ]; then
              echo "$id: did not extract modinfo.json" >&2
              exit 1
            fi
          fi

          # Mirror writeCredits, one block per lockfile entry. The soundless
          # variant omits soundpacks, the way release CI passes
          # --exclude-package-type soundpack for builds without sound.
          block="$display ($id)
    Source: $url
    Homepage: $homepage
    License: $license"
          printf '%s\n\n' "$block" >> bundle-root/mods/external-mods-CREDITS.txt
          if [ "$subdir" = "mods" ]; then
            printf '%s\n\n' "$block" >> bundle-root/mods/external-mods-CREDITS-mods-only.txt
          fi
        }

        rm -rf bundle-root
        mkdir -p bundle-root/mods
        for f in external-mods-CREDITS.txt external-mods-CREDITS-mods-only.txt; do
          {
            echo "Bundled registry mods"
            echo "====================="
            echo ""
          } > "bundle-root/mods/$f"
        done

        ${lib.concatMapStringsSep "\n" bundleCall entries}

        runHook postBuild
  '';

  installPhase = ''
    runHook preInstall
    mkdir -p $out
    cp -r bundle-root/. $out/
    runHook postInstall
  '';

  meta = {
    description = "Cataclysm-BN registry mods and soundpack (data/mods/external.json bundle)";
    homepage = "https://mods.cataclysmbn.org";
    # Mixed upstream licensing across entries (mostly
    # ALL-RIGHTS-RESERVED, plus CC-BY-SA-4.0/3.0); see the
    # external-mods-CREDITS.txt in the output for per-entry terms.
    platforms = lib.platforms.all;
  };
}
